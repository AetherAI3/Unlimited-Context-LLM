[Unit]
Description=Aether Context private overpool daemon
After=local-fs.target

[Service]
Type=simple
User=aether-context
Group=aether-codepro
RuntimeDirectory=aether-context
RuntimeDirectoryMode=0750
StateDirectory=aether-context
StateDirectoryMode=0700
UMask=0077
LoadCredential=context-dek:/etc/aether/context/credentials/context-dek
LoadCredential=context-signing-key:/etc/aether/context/credentials/context-signing-key
LoadCredential=context-authority-keys.json:/etc/aether/context/credentials/context-authority-keys.json
LoadCredential=context-proof-keys.json:/etc/aether/context/credentials/context-proof-keys.json
LoadCredential=context-checkpoint-keys.json:/etc/aether/context/credentials/context-checkpoint-keys.json
ExecStart=/opt/aether-context/venv/bin/aether-contextd --socket /run/aether-context/context.sock --database /var/lib/aether-context/context.sqlite3 --profile /etc/aether/context/profile.json --credentials ${CREDENTIALS_DIRECTORY}
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
MemoryMax=512M
TasksMax=32
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
